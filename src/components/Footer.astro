---
import { companyInfo } from '../data/companyInfo';
import { servicesData } from '../data/servicesData';
import { locationsData } from '../data/locationsData';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="container footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo">
          <div class="logo-mark">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
              <path d="M12 12v4"></path>
              <path d="M10 16h4"></path>
            </svg>
          </div>
          <span class="brand-title">ROVEO PLOMBERIE</span>
        </a>
        <p class="footer-desc">
          Artisan plombier chauffagiste certifié intervenant à Mons et sur l'ensemble de la zone frontalière. Spécialiste du dépannage d'urgence 24/7, recherche de fuite et rénovation de sanitaires.
        </p>
        <div class="footer-badges">
          <span class="cert-badge">Agrément Région Wallonne</span>
          <span class="cert-badge">Garantie Décennale</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-links">
          <li><a href="/">Accueil</a></li>
          <li><a href="/services">Nos Services</a></li>
          <li><a href="/locations">Zones d'intervention</a></li>
          <li><a href="/about">À propos de Roveo</a></li>
          <li><a href="/contact">Contact & Devis</a></li>
        </ul>
      </div>

      <!-- Col 3: Services -->
      <div class="footer-col">
        <h4 class="footer-heading">Services Principaux</h4>
        <ul class="footer-links">
          {servicesData.slice(0, 5).map((service) => (
            <li>
              <a href={`/services#${service.slug}`}>{service.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact & Hours -->
      <div class="footer-col contact-col">
        <h4 class="footer-heading">Contact & Urgence</h4>
        <div class="contact-card-footer">
          <p class="emergency-badge-text">Intervention 24h/24 et 7j/7</p>
          <a href={`tel:${companyInfo.phone}`} class="footer-phone-cta">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{companyInfo.phoneDisplay}</span>
          </a>
        </div>
        <p class="footer-address">
          <strong>Adresse:</strong> {companyInfo.address.street}, {companyInfo.address.postalCode} {companyInfo.address.city}
        </p>
        <p class="footer-address">
          <strong>Email:</strong> {companyInfo.email}
        </p>
        <p class="footer-address">
          <strong>BCE / TVA:</strong> {companyInfo.tvaNumber}
        </p>
      </div>
    </div>
  </div>

  <!-- Locations Ribbon -->
  <div class="footer-locations">
    <div class="container">
      <p class="locations-label"><strong>Communes desservies en priorité:</strong></p>
      <div class="locations-tags">
        {locationsData.map((loc) => (
          <a href={`/locations#${loc.id}`} class="location-tag">
            {loc.name}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="footer-bottom">
    <div class="container footer-bottom-content">
      <p>© {currentYear} Roveo Plomberie Mons. Tous droits réservés.</p>
      <div class="footer-bottom-links">
        <a href="/about">Mentions légales</a>
        <a href="/contact">Tarification transparente</a>
        <a href="/locations">Plan d'accès</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary-dark);
    color: #cbd5e1;
    font-size: 0.925rem;
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-top {
    padding: 4.5rem 0 3.5rem 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1.3fr;
    gap: 2.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .logo-mark {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-desc {
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cert-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-heading {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    letter-spacing: 0.02em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer-links a {
    color: #94a3b8;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #38bdf8;
    transform: translateX(3px);
  }

  .contact-card-footer {
    background: rgba(234, 88, 12, 0.1);
    border: 1px solid rgba(234, 88, 12, 0.3);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin-bottom: 1.25rem;
  }

  .emergency-badge-text {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #fdba74;
    margin-bottom: 0.4rem;
  }

  .footer-phone-cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .footer-phone-cta:hover {
    color: #fb923c;
  }

  .footer-address {
    color: #94a3b8;
    font-size: 0.85rem;
    margin-bottom: 0.4rem;
  }

  .footer-address strong {
    color: #cbd5e1;
  }

  .footer-locations {
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.5rem 0;
  }

  .locations-label {
    font-size: 0.85rem;
    color: #cbd5e1;
    margin-bottom: 0.75rem;
  }

  .locations-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .location-tag {
    background: rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .location-tag:hover {
    background: rgba(2, 132, 199, 0.2);
    color: #38bdf8;
  }

  .footer-bottom {
    padding: 1.5rem 0;
    font-size: 0.825rem;
    color: #64748b;
  }

  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-bottom-links a {
    color: #64748b;
  }

  .footer-bottom-links a:hover {
    color: #94a3b8;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
